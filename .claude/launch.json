{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "studio",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "artifacts/studio"
      ],
      "port": 5173,
      "autoPort": true,
      "env": {
        "BASE_PATH": "/"
      }
    },
    {
      "name": "studio-prod-data",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "artifacts/studio"
      ],
      "port": 5175,
      "env": {
        "PORT": "5175",
        "BASE_PATH": "/",
        "VITE_DEV_API_PROXY": "https://thesyndicate.money",
        "NODE_OPTIONS": "--use-system-ca"
      }
    },
    {
      "name": "api-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:rig",
        "--prefix",
        "artifacts/api-server"
      ],
      "port": 5000,
      "env": {
        "PORT": "5000",
        "NODE_ENV": "development",
        "DATABASE_URL": "postgresql://postgres:syndicate_local@localhost:5433/syndicate",
        "SYNDICATE_BACKBONE_ENABLED": "true"
      }
    },
    {
      "name": "mockup-sandbox",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "artifacts/mockup-sandbox"
      ],
      "port": 5174,
      "env": {
        "PORT": "5174",
        "BASE_PATH": "/"
      }
    }
  ]
}